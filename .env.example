# Backend Environment Variables
# LOCAL DEV: put real values in .env (gitignored); this file is the template.
# PRODUCTION: set by deploy.sh at deploy time, secrets via Secret Manager.

# Required for Vertex AI / Gemini
PROJECT_ID="test-rag-corpus-project"
FIREBASE_PROJECT_ID="sensei-ask-project"
LOCATION="us-west1"

# The shared corpus. Same corpus as Supplier Contract Review; nothing is
# re-ingested for this tool.
RAG_CORPUS="projects/test-rag-corpus-project/locations/us-west1/ragCorpora/137359788634800128"

# Models. Retrieval is cheap and mechanical; the narrative is the one that has
# to read the whole policy, so it gets the larger model.
RAG_RETRIEVAL_MODEL="gemini-2.5-flash"
RAG_GENERATION_MODEL="gemini-2.5-pro"

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS="http://localhost:8000,http://localhost:3000,https://www.scmsensei.ai"

# Local development only. Never set this in production: it turns off Firebase
# token verification on every submission route.
AUTH_DISABLED="false"
